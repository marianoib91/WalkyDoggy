<?xml version="1.0" encoding="utf-8"?>
<!--
  Modelo de Secrets.config. Copialo como "Secrets.config" (al lado de Web.config) y completalo.
  Secrets.config esta en .gitignore: no lo subas a git, tiene el Client Secret.

  Los datos salen de tu aplicacion en Mercado Pago Developers (https://www.mercadopago.com.ar/developers):
    - ClientId:     el "Client ID" / numero de la aplicacion
    - ClientSecret: el "Client secret" de la aplicacion
    - RedirectUri:  la "Redirect URL" cargada en la aplicacion. Tiene que ser EXACTAMENTE la misma, por ejemplo:
                    http://localhost:8085/api/mercadopago/callback
                    (Mercado Pago puede exigir https fuera de localhost.)
    - TestMode:     "true" mientras pruebes con cuentas de prueba (vendedor/comprador); "false" para operar con dinero real

  Pagos con retencion (los clientes le pagan a WalkyDoggy):
    - AccessToken:  el "Access Token" de la aplicacion. Con credenciales de prueba sale de "Credenciales de prueba";
                    para dinero real, de "Credenciales de produccion". Es una clave PRIVADA: no la subas a git ni la compartas.
                    Es lo unico obligatorio para cobrar; ClientId / ClientSecret / RedirectUri solo hacen falta si se habilita la
                    vinculacion de cuentas de paseadores (MercadoPago.LinkingEnabled = "true"), que esta en desuso.

  Avisos por mail (nueva solicitud, paseo confirmado, pago recibido, cancelaciones...):
    - Sin Smtp.Host los mails NO se mandan: se guardan como archivos .eml en WalkyDoggy.Web\App_Data\outbox
      (sirve para desarrollar y probar). Con Smtp.Host se mandan de verdad.
    - Para Gmail: Host smtp.gmail.com, Port 587, User = tu direccion y Password = una "contrasena de aplicacion"
      (cuenta de Google > Seguridad > Verificacion en dos pasos > Contrasenas de aplicaciones), NO tu contrasena normal.
    - App.BaseUrl: direccion de la app que llevan los links de los mails.

  Despues de crear o cambiar este archivo la aplicacion se reinicia sola.
-->
<appSettings>
  <add key="MercadoPago.ClientId" value="" />
  <add key="MercadoPago.ClientSecret" value="" />
  <add key="MercadoPago.RedirectUri" value="http://localhost:8085/api/mercadopago/callback" />
  <add key="MercadoPago.TestMode" value="true" />
  <add key="MercadoPago.AccessToken" value="" />

  <add key="App.BaseUrl" value="http://localhost:8085" />
  <add key="Smtp.Host" value="" />
  <add key="Smtp.Port" value="587" />
  <add key="Smtp.User" value="" />
  <add key="Smtp.Password" value="" />
  <add key="Smtp.From" value="WalkyDoggy &lt;no-reply@walkydoggy.local&gt;" />
</appSettings>
